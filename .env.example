# Database
DATABASE_URL="file:./dev.db"

# Auth
NEXTAUTH_SECRET="civiclens-demo-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider (optional - mock provider works without API keys)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
GROK_API_KEY=""

# Map (optional - OpenStreetMap works without keys)
MAP_API_KEY=""

# File Storage
UPLOAD_DIR="public/uploads"

# App
APP_NAME="CivicLens"
DEMO_MODE="true"
